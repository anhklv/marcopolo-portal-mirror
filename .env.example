# Database connection string for PostgreSQL
# ローカル開発（docker compose）— 通常はこちら
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marcopolo_portal_dev"
# Supabase 直結（必要な場合のみ）
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# 認証（Auth.js）
# AUTH_SECRET は `npx auth secret` で生成
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# 実行環境識別子（local / develop / staging / production）
APP_ENV=local

# メールプロバイダ（resend / mailpit）
# 未指定時は mailpit（MailPit: localhost:1025）
MAIL_PROVIDER=mailpit

# SMTP（開発環境: MailPit）
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.com

# Resend（MAIL_PROVIDER=resend のとき必要。本番）
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxx
# RESEND_WEBHOOK_SECRET=whsec_xxxx
# HOSTとPORTは lib/mail/client.ts にハードコーディング

# コミュニティ通知（ID14の送信エラー通知、および今後のID17通知で共通利用）
# 複数宛先はカンマ、セミコロン、または改行で区切る
COMMUNITY_NOTIFICATION_ENABLED=false
COMMUNITY_NOTIFICATION_TO_NAIKAN_MEETUP=
COMMUNITY_NOTIFICATION_TO_VENTURE_AUDITOR=
COMMUNITY_NOTIFICATION_TO_AI_CLUB=
# develop/stagingでは上記の実宛先を置き換えるテスト用アドレスを設定する
COMMUNITY_NOTIFICATION_OVERRIDE_TO=
# 未完了のResend結果を待つ時間（本番既定値: 180秒）
MAIL_FAILURE_NOTIFICATION_WAIT_SECONDS=180
# Vercel Cronからの呼び出しを保護する共有シークレット
CRON_SECRET=

# アプリケーションベースURL（本番・staging では必須。未設定時はリクエストヘッダー等から自動取得）
APP_BASE_URL=http://localhost:3000

# 開発メニュー・スタイルガイド・/docs 閲覧（ローカル・staging: true / 本番: 未設定または false）
DEBUG_ADMIN_PANEL=true
