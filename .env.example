# Database connection string for PostgreSQL
# ローカル開発（docker compose）— 通常はこちら
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marcopolo_portal_dev"
# Supabase 直結（必要な場合のみ）
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# 認証（Auth.js）
# AUTH_SECRET は `npx auth secret` で生成
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# メールプロバイダ（resend / mailpit）
# 未指定時は mailpit（MailPit: localhost:1025）
MAIL_PROVIDER=mailpit

# SMTP（開発環境: MailPit）
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.com

# Resend（MAIL_PROVIDER=resend のとき必要。本番・staging）
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxx
# HOSTとPORTは lib/mail/client.ts にハードコーディング

# アプリケーションベースURL（本番・staging では必須。未設定時はリクエストヘッダー等から自動取得）
APP_BASE_URL=http://localhost:3000

# 開発メニュー・スタイルガイド・/docs 閲覧（ローカル・staging: true / 本番: 未設定または false）
DEBUG_ADMIN_PANEL=true
