# Database connection string for PostgreSQL
# Supabase Direct（ローカル開発用）
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
# docker-compose.yml のPostgreSQLコンテナに接続する場合
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marcopolo_portal_dev"

# SMTP（開発環境: MailPit）
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=takashi.aoki@calme.dev

# アプリケーションベースURL（本番・staging Production のみ設定。未設定時はリクエストヘッダー等から自動取得）
APP_BASE_URL=http://localhost:3000

# 本番のみ (Resend)
# SMTP_USER=resend
# SMTP_PASS=re_xxxx
