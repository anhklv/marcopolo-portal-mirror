// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================
// ENUM Definitions
// ======================

enum Gender {
  male
  female
}

enum MemberCategory {
  member
  sponsor
  observer
}

enum ContractType {
  corporate
  individual
}

enum AuditMemberType {
  regular
  online
}

enum AdminRole {
  super
  community_admin
}

enum RsvpStatus {
  pending
  attending
  online
  absent
}

enum AfterPartyStatus {
  attending
  not_attending
}

enum ParticipationMode {
  disabled
  optional
  required
}

enum EventMailKind {
  rsvp
  survey
  notice
}

enum EventMailState {
  draft
  sent
}

enum EventMailSendStatus {
  processing
  success
  partial_failed
  failed
}

enum EventMailAddressType {
  main
  sub
}

enum EventMailDeliveryStatus {
  pending
  success
  failed
}

enum SurveyRating {
  excellent
  good
  fair
  poor
}

enum FutureParticipation {
  definitely_yes
  considering
  no
}

enum MembershipInterest {
  want_to_join
  considering
  not_interested
}

/// 転職意欲（顧客プロフィール）
enum JobChangeIntent {
  active        // 積極的に検討中
  considering   // 検討している
  if_good       // よい案件があれば
  not_thinking  // 全く考えていない
}

// ======================
// Master Tables
// ======================

model Community {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  hasSurvey Boolean  @default(false) @map("has_survey")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customerCommunities CustomerCommunity[]
  events              Event[]
  adminCommunities    AdminCommunity[]

  @@map("communities")
}

model Prefecture {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customers Customer[]

  @@map("prefectures")
}

model ListingCategory {
  id                Int      @id @default(autoincrement())
  marketName        String   @map("market_name") @db.VarChar(100)
  stockExchangeName String   @default("") @map("stock_exchange_name") @db.VarChar(100)
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  customers Customer[]

  @@unique([marketName, stockExchangeName])
  @@map("listing_categories")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customerDepartments CustomerDepartment[]

  @@map("departments")
}

model OriginIndustry {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customerCommunities CustomerCommunity[]

  @@map("origin_industries")
}

model MembershipQualification {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customerCommunities CustomerCommunity[]

  @@map("membership_qualifications")
}

model Affiliation {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customerCommunities CustomerCommunity[]

  @@map("affiliations")
}

// ======================
// Customer Tables
// ======================

model Customer {
  id                        Int             @id @default(autoincrement())
  lastName                  String          @map("last_name") @db.VarChar(100)
  firstName                 String          @map("first_name") @db.VarChar(100)
  lastNameKana              String?         @map("last_name_kana") @db.VarChar(100)
  firstNameKana             String?         @map("first_name_kana") @db.VarChar(100)
  company                   String?         @db.VarChar(200)
  position                  String?         @db.VarChar(50)
  email                     String          @db.VarChar(255)
  subEmails                 String[]        @default([]) @map("sub_emails")
  phone                     String?         @db.VarChar(20)
  postalCode                String?         @map("postal_code") @db.VarChar(10)
  prefectureId              Int?            @map("prefecture_id")
  city                      String?         @db.VarChar(255)
  gender                    Gender?
  listingCategoryId         Int?            @map("listing_category_id")
  memberCategory            MemberCategory? @map("member_category")
  contractType              ContractType?   @map("contract_type")
  jobChangeIntent           JobChangeIntent? @map("job_change_intent")
  note                      String?         @db.Text
  registeredAt              DateTime        @default(now()) @map("registered_at")
  deletedAt                 DateTime?       @map("deleted_at")

  // Relations
  prefecture              Prefecture?              @relation(fields: [prefectureId], references: [id])
  listingCategory         ListingCategory?         @relation(fields: [listingCategoryId], references: [id])
  customerCommunities     CustomerCommunity[]
  customerDepartments     CustomerDepartment[]
  rsvps                   Rsvp[]
  surveyResponses         SurveyResponse[]
  fixedSurveyResponses    FixedSurveyResponse[]
  surveyTokens            SurveyToken[]
  eventMailDeliveries     EventMailDelivery[]

  @@map("customers")
}

model CustomerDepartment {
  id           Int      @id @default(autoincrement())
  customerId   Int      @map("customer_id")
  departmentId Int      @map("department_id")
  note         String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  customer   Customer   @relation(fields: [customerId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([customerId, departmentId])
  @@map("customer_departments")
}

model CustomerCommunity {
  id                        Int             @id @default(autoincrement())
  customerId                Int             @map("customer_id")
  communityId               Int             @map("community_id")
  joinedAt                  DateTime?       @db.Date @map("joined_at")
  resignedAt                DateTime?       @db.Date @map("resigned_at")
  auditMemberType           AuditMemberType? @map("audit_member_type")
  auditMemberPremium        Boolean?        @map("audit_member_premium")
  affiliationId             Int?            @map("affiliation_id")
  originIndustryId          Int?            @map("origin_industry_id")
  membershipQualificationId Int?            @map("membership_qualification_id")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  // Relations
  customer                Customer                 @relation(fields: [customerId], references: [id])
  community               Community                @relation(fields: [communityId], references: [id])
  affiliation             Affiliation?             @relation(fields: [affiliationId], references: [id])
  originIndustry          OriginIndustry?          @relation(fields: [originIndustryId], references: [id])
  membershipQualification MembershipQualification? @relation(fields: [membershipQualificationId], references: [id])

  @@unique([customerId, communityId])
  @@map("customer_communities")
}

// ======================
// Event Tables
// ======================

model Event {
  id               Int       @id @default(autoincrement())
  communityId      Int       @map("community_id")
  title            String    @db.VarChar(200)
  date             DateTime
  location         String?   @db.VarChar(255)
  description      String?   @db.Text
  timetable        String?   @db.Text
  note             String?   @db.Text
  attendeesCount   Int       @default(0) @map("attendees_count")
  responseDeadline DateTime? @map("response_deadline")
  isPaused         Boolean   @default(false) @map("is_paused")
  allowsOnline     Boolean   @default(false) @map("allows_online")
  hasAfterParty    Boolean   @default(false) @map("has_after_party")
  participationMode ParticipationMode @default(disabled) @map("participation_mode")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations
  community Community @relation(fields: [communityId], references: [id])
  rsvps     Rsvp[]
  survey    Survey?
  participationOptions EventParticipationOption[]
  eventMails            EventMail[]

  @@map("events")
}

model EventParticipationOption {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  label     String   @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event  @relation(fields: [eventId], references: [id])
  rsvps Rsvp[]

  @@index([eventId, isActive, sortOrder])
  @@map("event_participation_options")
}

model Rsvp {
  id               Int              @id @default(autoincrement())
  eventId          Int              @map("event_id")
  customerId       Int              @map("customer_id")
  token            String           @unique @db.VarChar(100)
  status           RsvpStatus       @default(pending)
  afterPartyStatus AfterPartyStatus? @map("after_party_status")
  participationOptionId Int?              @map("participation_option_id")
  comment          String?          @db.Text
  adminNote        String?          @map("admin_note") @db.Text
  respondedAt      DateTime?        @map("responded_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  event    Event    @relation(fields: [eventId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  participationOption EventParticipationOption? @relation(fields: [participationOptionId], references: [id], onDelete: Restrict)

  @@unique([eventId, customerId])
  @@index([participationOptionId])
  @@map("rsvps")
}

model EventMail {
  id                   Int                  @id @default(autoincrement())
  eventId              Int                  @map("event_id")
  templateNameSnapshot String?              @map("template_name_snapshot") @db.VarChar(200)
  kind                 EventMailKind
  state                EventMailState       @default(draft)
  subject              String               @db.VarChar(500)
  body                 String               @db.Text
  fromAddress          String               @map("from_address") @db.VarChar(255)
  createdByAdminId     Int                  @map("created_by_admin_id")
  sentByAdminId        Int?                 @map("sent_by_admin_id")
  sendStatus           EventMailSendStatus? @map("send_status")
  targetCount          Int                  @default(0) @map("target_count")
  successCount         Int                  @default(0) @map("success_count")
  failedCount          Int                  @default(0) @map("failed_count")
  sentAt               DateTime?            @map("sent_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  event          Event               @relation(fields: [eventId], references: [id])
  createdByAdmin Admin               @relation("EventMailCreatedBy", fields: [createdByAdminId], references: [id])
  sentByAdmin    Admin?              @relation("EventMailSentBy", fields: [sentByAdminId], references: [id])
  deliveries    EventMailDelivery[]

  @@index([eventId, sentAt])
  @@index([eventId, state])
  @@index([sendStatus])
  @@map("event_mails")
}

model EventMailDelivery {
  id                Int                     @id @default(autoincrement())
  eventMailId       Int                     @map("event_mail_id")
  customerId        Int                     @map("customer_id")
  lastNameSnapshot  String                  @map("last_name_snapshot") @db.VarChar(100)
  firstNameSnapshot String                  @map("first_name_snapshot") @db.VarChar(100)
  emailAddress      String                  @map("email_address") @db.VarChar(255)
  emailType         EventMailAddressType    @map("email_type")
  subEmailOrder     Int?                    @map("sub_email_order")
  status            EventMailDeliveryStatus @default(pending)
  smtpMessageId     String?                 @map("smtp_message_id") @db.VarChar(255)
  errorCode         String?                 @map("error_code") @db.VarChar(100)
  errorMessage      String?                 @map("error_message") @db.Text
  sentAt            DateTime?               @map("sent_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  eventMail EventMail @relation(fields: [eventMailId], references: [id], onDelete: Cascade)
  customer  Customer  @relation(fields: [customerId], references: [id])

  @@index([eventMailId, status])
  @@index([customerId])
  @@map("event_mail_deliveries")
}

// ======================
// Survey Tables
// ======================

model Survey {
  id        Int      @id @default(autoincrement())
  eventId   Int      @unique @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  event                Event                @relation(fields: [eventId], references: [id])
  questions            SurveyQuestion[]
  fixedSurveyResponses FixedSurveyResponse[]
  tokens               SurveyToken[]

  @@map("surveys")
}

model SurveyQuestion {
  id        Int      @id @default(autoincrement())
  surveyId  Int      @map("survey_id")
  title     String   @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  survey    Survey           @relation(fields: [surveyId], references: [id])
  responses SurveyResponse[]

  @@map("survey_questions")
}

/// 自由設問への回答
/// - surveyId は question.surveyId 経由で取得可能なため保持しない（整合性担保）
/// - surveyTokenId で回答時のトークンを参照（参照整合性担保）
model SurveyResponse {
  id            Int           @id @default(autoincrement())
  questionId    Int           @map("question_id")
  customerId    Int           @map("customer_id")
  surveyTokenId Int           @map("survey_token_id")
  rating        SurveyRating?
  reason        String?       @db.Text
  respondedAt   DateTime?     @map("responded_at")

  // Relations
  question    SurveyQuestion @relation(fields: [questionId], references: [id])
  customer    Customer       @relation(fields: [customerId], references: [id])
  surveyToken SurveyToken    @relation(fields: [surveyTokenId], references: [id])

  @@unique([questionId, customerId])
  @@map("survey_responses")
}

/// 固定設問への回答
/// - surveyTokenId で回答時のトークンを参照（参照整合性担保）
///
/// null許容条件:
/// - afterPartyRating/afterPartyReason: event.hasAfterParty === true の場合のみ入力
/// - futureParticipation/futureParticipationReason: 常に入力対象
/// - membership/membershipReason: ベンチャー監査役の会イベント かつ 非会員の場合のみ入力
/// - comments: 任意入力
model FixedSurveyResponse {
  id                          Int                  @id @default(autoincrement())
  surveyId                    Int                  @map("survey_id")
  customerId                  Int                  @map("customer_id")
  surveyTokenId               Int                  @map("survey_token_id")
  afterPartyRating            SurveyRating?        @map("after_party_rating")
  afterPartyReason            String?              @map("after_party_reason") @db.Text
  futureParticipation         FutureParticipation? @map("future_participation")
  futureParticipationReason   String?              @map("future_participation_reason") @db.Text
  membership                  MembershipInterest?
  membershipReason            String?              @map("membership_reason") @db.Text
  comments                    String?              @db.Text
  respondedAt                 DateTime?            @map("responded_at")

  // Relations
  survey      Survey      @relation(fields: [surveyId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  surveyToken SurveyToken @relation(fields: [surveyTokenId], references: [id])

  @@unique([surveyId, customerId])
  @@map("fixed_survey_responses")
}

/// アンケートトークン管理
/// - token は全体でUNIQUE（URLで使用）
/// - 再送時は既存レコードの sentAt を更新（新規作成しない）
model SurveyToken {
  id         Int       @id @default(autoincrement())
  surveyId   Int       @map("survey_id")
  customerId Int       @map("customer_id")
  token      String    @unique @db.VarChar(100)
  sentAt     DateTime? @map("sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  survey               Survey                @relation(fields: [surveyId], references: [id])
  customer             Customer              @relation(fields: [customerId], references: [id])
  surveyResponses      SurveyResponse[]
  fixedSurveyResponses FixedSurveyResponse[]

  @@unique([surveyId, customerId])
  @@map("survey_tokens")
}

// ======================
// Admin Tables
// ======================

model Admin {
  id           Int       @id @default(autoincrement())
  lastName     String    @map("last_name") @db.VarChar(50)
  firstName    String    @map("first_name") @db.VarChar(50)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         AdminRole
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  adminCommunities AdminCommunity[]
  createdEventMails EventMail[] @relation("EventMailCreatedBy")
  sentEventMails    EventMail[] @relation("EventMailSentBy")

  @@map("admins")
}

model AdminCommunity {
  id          Int      @id @default(autoincrement())
  adminId     Int      @map("admin_id")
  communityId Int      @map("community_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  admin     Admin     @relation(fields: [adminId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([adminId, communityId])
  @@map("admin_communities")
}
